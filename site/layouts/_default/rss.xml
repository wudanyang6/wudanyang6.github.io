{{- $pages := .Pages -}}
{{- if not $pages -}}{{- $pages = .Site.RegularPages -}}{{- end -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/">
<channel>
  <title>{{ .Site.Title }}</title>
  <link>{{ .Permalink }}</link>
  <description>{{ .Site.Params.description }}</description>
  <language>zh-CN</language>
  <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
{{ range $pages }}
  <item>
    <title>{{ .Title }}</title>
    <link>{{ .Params.externalURL }}</link>
    <guid isPermaLink="true">{{ .Params.externalURL }}</guid>
    <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
    <description>{{ .Summary | transform.XMLEscape }}</description>
    {{ range .Params.tags }}<category>{{ . }}</category>
    {{ end }}<content:encoded>{{ .Content | transform.XMLEscape }}</content:encoded>
  </item>
{{ end }}
</channel>
</rss>
